{
  "skill": "skill-creator",
  "purpose": "Meta-evals for the skill-creator surface itself. Loaded by tests/skills_smoke.sh and re-runnable manually.",
  "evals": [
    {
      "id": "validate-self-clean",
      "kind": "mechanical",
      "command": "python3 plugins/skill-creator/skills/skill-creator/scripts/validate.py plugins/skill-creator/skills/skill-creator",
      "expect_exit": 0,
      "description": "Self-dogfood — the validator must pass against its own folder."
    },
    {
      "id": "audit-library-runs",
      "kind": "mechanical",
      "command": "python3 plugins/skill-creator/skills/skill-creator/scripts/audit_library.py plugins/skill-creator/skills",
      "expect_exit_max": 1,
      "description": "Auditor walks the library without erroring out (exit 0 or 1, never 2)."
    },
    {
      "id": "validate-memory-runs",
      "kind": "mechanical",
      "command": "python3 plugins/skill-creator/skills/skill-creator/scripts/validate_memory.py --root .",
      "expect_exit_max": 1,
      "description": "Memory-layer validator walks the repo without erroring out."
    },
    {
      "id": "init-skill-scaffolds",
      "kind": "mechanical",
      "command": "python3 plugins/skill-creator/skills/skill-creator/scripts/init_skill.py probe-temp --library /tmp/skill-creator-evals && rm -rf /tmp/skill-creator-evals",
      "expect_exit": 0,
      "description": "init_skill scaffolds a fresh skill folder from templates."
    }
  ]
}

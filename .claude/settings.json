{
  "statusLine": {
    "type": "command",
    "command": "bash claude-arsenal/bin/statusline_capture.sh"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash tools/profile_guard.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash claude-arsenal/bin/check_skill_workshop_loaded.sh"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash tools/bootstrap_hook.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash claude-arsenal/bin/mark_skill_workshop_loaded.sh"
          }
        ],
        "matcher": "Skill"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash claude-arsenal/bin/mark_skill_workshop_loaded_from_prompt.sh"
          }
        ]
      }
    ]
  }
}
